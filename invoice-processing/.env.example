# LLM
ANTHROPIC_API_KEY=sk-ant-...
DEMO_MODEL=claude-haiku-4-5-20251001

# Database
DATABASE_URL=postgresql://demo:demo@localhost:5432/tenuo_demo

# Services
VENDOR_PORTAL_URL=http://localhost:8082
OPA_URL=http://localhost:8181

# Tenuo mode: "local" (self-serve, no cloud) or "cloud" (requires Tenuo Cloud)
TENUO_MODE=local

# Tenuo Cloud (only needed when TENUO_MODE=cloud)
# TENUO_CONTROL_PLANE_URL=https://api-staging.tenuo.ai   # base URL — no /v1 suffix
# TENUO_API_KEY=tc_...
# TENUO_AGENT_ID=<agent ID from dashboard>
# TENUO_CONNECT_TOKEN=tenuo_ct_...   # Quick Connect token from dashboard (preferred)
# TENUO_ROOT_PUBLIC_KEY=<base64-encoded root public key from dashboard>
#
# Warrant — two options, use one:
#   Option A: paste a warrant token fired manually from staging.tenuo.ai
# TENUO_WARRANT=<base64 warrant token>
#   Option B: let the demo auto-fire the trigger (uses TENUO_API_KEY)
# TENUO_ADMIN_API_KEY=tc_...
