# ──────────────────────────────────────────────────────────────────────────
# Temporal connection
# ──────────────────────────────────────────────────────────────────────────
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=incident-response

# ──────────────────────────────────────────────────────────────────────────
# Approval UI (launched in-process by run.py at this host:port)
# ──────────────────────────────────────────────────────────────────────────
APPROVAL_HOST=127.0.0.1
APPROVAL_PORT=5050

# Tenuo signing keys are generated per session by run.py; nothing to set
# here. To pin stable keys across runs (e.g., for repeated experiments
# against the same Temporal history), export TENUO_KEY_oncall-lead and
# TENUO_KEY_ai-oncall-agent-001 as base64-encoded Ed25519 secret keys
# before invoking the demo.

# ──────────────────────────────────────────────────────────────────────────
# LLM (optional — env-gated)
# When ANTHROPIC_API_KEY is set, the demo uses live Claude Haiku for the
# agent's reasoning. When unset, the demo replays a recorded LLM cassette
# from fixtures/llm_cassette.json. Both paths produce identical structure.
# ──────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ──────────────────────────────────────────────────────────────────────────
# Demo configuration
# ──────────────────────────────────────────────────────────────────────────
# DEMO_VERBOSE=1     → print full audit events as they emit
# DEMO_NO_COLOR=1    → disable colored terminal output
DEMO_VERBOSE=0
DEMO_NO_COLOR=0
