# ---- Tenuo Cloud Configuration ----
# Sign up at https://staging.tenuo.cloud to get these values.

# Control plane API URL
TENUO_CONTROL_PLANE_URL=https://api-staging.tenuo.ai

# API key (created in Helios dashboard → Settings → API Keys)
TENUO_API_KEY=tc_your_api_key_here

# Trigger ID (created in Helios dashboard → Triggers)
TENUO_TRIGGER_ID=shopping-agent-v1

# Tenant ID (shown in Helios dashboard → Settings)
TENUO_TENANT_ID=

# Trusted root public key (base64-encoded Ed25519, from Helios → Keys)
# If not set, fetched automatically from /.well-known/tenuo-keys
TENUO_TRUSTED_ROOT=

# Agent signing keys (base64-encoded Ed25519 private keys)
# Generated during agent registration: Helios → Agents → Register
#
# The demo runs a three-hop chain (orchestrator → planner → executor):
#   - TENUO_ORCHESTRATOR_KEY signs the planner warrant
#   - TENUO_PLANNER_KEY (optional) signs the executor warrant
#       If unset, an ephemeral planner key is generated each run.
#   - TENUO_WORKER_KEY is the executor's key (the one that ultimately
#     fronts add_to_cart). Name preserved for backwards compatibility.
TENUO_ORCHESTRATOR_KEY=
TENUO_PLANNER_KEY=
TENUO_WORKER_KEY=

# ---- Skyvern Configuration ----
# Skyvern reads its config from `Path.cwd() / .env`. If you launch
# `skyvern run server` from this directory (recommended — see tutorial Step 4),
# the values below are picked up by both `task.py` and the Skyvern server.

# Override if Skyvern runs on a different host/port (default: http://localhost:8000)
# SKYVERN_BASE_URL=http://localhost:8000

# Skyvern API key (required — Skyvern auth is enabled by default).
# Run `skyvern init` once, or seed programmatically via
# `skyvern.cli.mcp.setup_local_organization()`. Tutorial Troubleshooting has details.
# SKYVERN_API_KEY=eyJ...

# Database (psycopg over asyncpg — see tutorial Step 2 for why).
# DATABASE_STRING=postgresql+psycopg://skyvern:skyvern@localhost:5432/skyvern

# Browser & SSRF allowlist for the local demo store.
# BROWSER_TYPE=chromium-headful
# ALLOWED_HOSTS=["localhost"]

# ---- LLM Configuration ----
# Pick one provider. Skyvern only registers a model if its ENABLE_* flag is true.

# OpenAI:
# ENABLE_OPENAI=true
# OPENAI_API_KEY=sk-...
# LLM_KEY=OPENAI_GPT4O

# Anthropic:
# ENABLE_ANTHROPIC=true
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_KEY=ANTHROPIC_CLAUDE4.5_SONNET
